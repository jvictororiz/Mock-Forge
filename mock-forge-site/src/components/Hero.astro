---
import type { Messages } from '../i18n/messages';
import BrandLockup from './BrandLockup.astro';

type Props = {
  t: Messages;
  downloadHref: string;
};

const { t, downloadHref } = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    <div class="brand-row reveal">
      <img class="brand-icon" src="/icon.png" alt="" width="48" height="48" />
      <BrandLockup name={t.brand.name} size="hero" />
    </div>
    <h1 class="reveal" style="transition-delay: 80ms">{t.hero.headline}</h1>
    <p class="sub reveal" style="transition-delay: 140ms">{t.hero.sub}</p>
    <div class="actions reveal" style="transition-delay: 200ms">
      <a class="btn btn-primary" href={downloadHref}>{t.hero.ctaPrimary}</a>
      <a class="btn btn-ghost" href="#product">{t.hero.ctaSecondary}</a>
    </div>
  </div>
  <div class="glow" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(3.25rem, 8vw, 5.5rem) 0 clamp(2.5rem, 5vw, 3.5rem);
    overflow: visible;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 38rem;
    overflow: visible;
  }

  .brand-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
    overflow: visible;
  }

  .brand-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.32);
    flex-shrink: 0;
  }

  h1 {
    margin: 0 0 0.85rem;
    padding-block: 0.18em 0.25em;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 600;
    font-stretch: normal;
    letter-spacing: -0.015em;
    line-height: 1.55;
    max-width: 24ch;
    overflow: visible;
    color: var(--text);
  }

  .sub {
    margin: 0 0 1.5rem;
    color: var(--text-muted);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.7;
    max-width: 36rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .glow {
    position: absolute;
    right: -6%;
    top: 8%;
    width: min(42vw, 380px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(73, 204, 144, 0.18), transparent 68%);
    filter: blur(6px);
    pointer-events: none;
  }

  @media (max-width: 560px) {
    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
    }

    h1 {
      max-width: none;
    }
  }
</style>
