---
import type { Messages } from '../i18n/messages';

type Props = { t: Messages };
const { t } = Astro.props;
---

<section class="section screenshots" id="screenshots">
  <div class="container">
    <div class="section-head reveal">
      <h2>{t.screenshots.title}</h2>
      <p>{t.screenshots.sub}</p>
    </div>

    <ul class="gallery">
      {
        t.screenshots.items.map((item, index) => (
          <li class="shot reveal" style={`transition-delay: ${index * 70}ms`}>
            <figure>
              <div class="frame">
                <img
                  src={`/screenshots/${item.file}`}
                  alt={item.title}
                  width="960"
                  height="600"
                  loading="lazy"
                />
              </div>
              <figcaption>
                <strong>{item.title}</strong>
                <span>{item.caption}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .screenshots {
    border-block: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.015);
  }

  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  figure {
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: calc(var(--radius) + 4px);
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  figcaption {
    display: grid;
    gap: 0.2rem;
    margin-top: 0.7rem;
  }

  figcaption strong {
    padding-block: 0.15em 0.22em;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.55;
    overflow: visible;
  }

  figcaption span {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  @media (min-width: 900px) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.15rem;
    }

    .frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
