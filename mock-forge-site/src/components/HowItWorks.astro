---
import type { Messages } from '../i18n/messages';

type Props = { t: Messages };
const { t } = Astro.props;
---

<section class="section how" id="how">
  <div class="container">
    <div class="section-head reveal">
      <h2>{t.how.title}</h2>
      <p>{t.how.sub}</p>
    </div>
    <ol class="steps">
      {
        t.how.steps.map((step, index) => (
          <li class="step reveal" style={`transition-delay: ${index * 70}ms`}>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how {
    border-block: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.015);
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .step {
    display: grid;
    gap: 0.65rem;
  }

  .num {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    font-stretch: normal;
    letter-spacing: -0.02em;
    line-height: 1.55;
    overflow: visible;
    color: var(--accent);
  }

  h3 {
    margin: 0 0 0.35rem;
    padding-block: 0.15em 0.22em;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-stretch: normal;
    letter-spacing: -0.01em;
    line-height: 1.55;
    overflow: visible;
  }

  p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  @media (max-width: 800px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
</style>
