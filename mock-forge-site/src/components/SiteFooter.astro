---
import type { Messages } from '../i18n/messages';
import BrandLockup from './BrandLockup.astro';

type Props = { t: Messages };
const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <BrandLockup name={t.brand.name} size="footer" />
      <span class="footer-year">· {year}</span>
    </div>
    <span>{t.footer.mit}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding: 1.25rem 0 1.75rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    justify-content: space-between;
    align-items: center;
    color: var(--text-dim);
    font-size: 0.84rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .footer-year {
    align-self: center;
    color: var(--text-dim);
  }
</style>
