---
import type { Messages } from '../i18n/messages';
import { GITHUB_URL } from '../lib/constants';

type Props = { t: Messages };
const { t } = Astro.props;
---

<section class="section oss">
  <div class="container reveal">
    <h2>{t.openSource.title}</h2>
    <p>{t.openSource.body}</p>
    <a class="btn btn-ghost" href={GITHUB_URL} target="_blank" rel="noreferrer">{t.openSource.cta}</a>
  </div>
</section>

<style>
  .oss {
    padding-top: 0;
  }

  .container {
    max-width: 34rem;
  }

  h2 {
    margin: 0 0 0.55rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
    letter-spacing: -0.03em;
  }

  p {
    margin: 0 0 1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
