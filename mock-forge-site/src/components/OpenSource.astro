---
import type { Messages } from '../i18n/messages';

type Props = { t: Messages };
const { t } = Astro.props;
---

<section class="section oss">
  <div class="container reveal">
    <h2>{t.openSource.title}</h2>
    <p>{t.openSource.body}</p>
  </div>
</section>

<style>
  .oss {
    padding-top: 0;
  }

  .container {
    max-width: 34rem;
  }

  h2 {
    margin: 0 0 0.55rem;
    padding-block: 0.18em 0.28em;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
    letter-spacing: -0.03em;
    line-height: 1.55;
    overflow: visible;
  }

  p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>
